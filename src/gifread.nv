pub fn frames_of(bytes: Bytes, o: GifReadOptions) -> Result<[GifFrame], GifFault> []
    todo("gif-nv.gifread.frames_of")

// Whether these bytes begin `GIF87a` or `GIF89a`.
//
// Six bytes, so it answers on a header a caller has barely started
// reading.  It is what a format sniffer calls, and it never refuses:
// a short slice is simply not a GIF yet.
//
// ```novo
// use std.bytes
// use gifread
//
// fn main() [io]
//     println("${gifread.looks_like_gif(bytes.from_byte_list([0x47, 0x49, 0x46, 0x38, 0x39, 0x61]))}")   // true
// ```
pub fn looks_like_gif(bytes: Bytes) -> Bool []
    todo("gif-nv.gifread.looks_like_gif")

// The canvas size read from the first thirteen bytes, without
// decoding anything else.
//
// WHAT A SIZE LIMIT IS CHECKED AGAINST.  A caller deciding whether to
// accept a file at all asks this first: the answer costs thirteen
// bytes and no allocation, and a canvas of 65535 by 65535 is refused
// before a buffer for it is ever considered.
//
// ```novo
// use std.bytes
// use gifread
//
// fn main() [io]
//     let head = bytes.from_byte_list([0x47, 0x49, 0x46, 0x38, 0x39, 0x61,
//                                      0x40, 0x00, 0x20, 0x00, 0x00, 0x00, 0x00])
//     match gifread.probe_size(head)
//         Some(wh) => println("${wh.0} by ${wh.1}")   // 64 by 32
//         None     => println("not enough bytes yet")
// ```
pub fn probe_size(bytes: Bytes) -> ?(Int, Int) []
    todo("gif-nv.gifread.probe_size")
