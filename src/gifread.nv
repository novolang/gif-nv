// A decoder that has been fed nothing.
//
// ```novo
// use gifread
//
// fn main() [io]
//     println("${gifread.reader(gifread.default_options()).offset}")   // 0
// ```
pub fn reader(o: GifReadOptions) -> GifReader []
    todo("gif-nv.gifread.reader")

// Bytes in.  Answers the decoder's new state and every event those
// bytes completed.
//
// A slice that completes nothing answers an empty list, which is the
// ordinary case when a caller feeds 1500 bytes at a time.
//
// ```novo
// use std.bytes
// use std.list
// use gifread
//
// fn main() [io]
//     let r = gifread.reader(gifread.default_options())
//     match gifread.feed(r, bytes.from_byte_list([0x47, 0x49, 0x46, 0x38, 0x39, 0x61]))
//         Ok(step) => println("${list.len(step.1)}")   // 0 — the screen needs seven more bytes
//         Err(e)   => println(e.message())
// ```
pub fn feed(r: GifReader, bytes: Bytes) -> Result<(GifReader, [GifEvent]), GifFault> []
    todo("gif-nv.gifread.feed")

// The statement that there are no more bytes.
//
// Answers `GifTruncated` when a block is still open — which is the
// refusal a caller whose download failed needs, and the one `feed`
// cannot raise, because only the caller knows the stream has ended.
//
// ```novo
// use gifread
//
// fn main() [io]
//     match gifread.finish(gifread.reader(gifread.default_options()))
//         Ok(_)  => println("a stream that is nothing at all is not complete")
//         Err(e) => println(e.message())
// ```
pub fn finish(r: GifReader) -> Result<[GifEvent], GifFault> []
    todo("gif-nv.gifread.finish")

// Whether the trailer has been seen.
//
// ```novo
// use gifread
//
// fn main() [io]
//     println("${gifread.is_complete(gifread.reader(gifread.default_options()))}")   // false
// ```
pub fn is_complete(r: GifReader) -> Bool []
    todo("gif-nv.gifread.is_complete")

