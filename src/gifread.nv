    todo("gif-nv.gifread.event_name")

// A whole stream decoded at once, for a caller that already holds
// every byte.
//
// ```novo
// use std.bytes
// use std.list
// use gifread
//
// fn main() [io]
//     match gifread.decode_all(bytes.from_byte_list([0x47, 0x49, 0x46]), gifread.default_options())
//         Ok(events) => println("${list.len(events)}")
//         Err(e)     => println(e.message())
// ```
pub fn decode_all(bytes: Bytes, o: GifReadOptions) -> Result<[GifEvent], GifFault> []
    todo("gif-nv.gifread.decode_all")

// Only the frames of a stream, for the ordinary case.
//
// ```novo
// use std.bytes
// use std.list
// use gifread
//
// fn main() [io]
//     match gifread.frames_of(bytes.from_byte_list([0x47, 0x49, 0x46]), gifread.default_options())
//         Ok(frames) => println("${list.len(frames)}")
//         Err(e)     => println(e.message())
