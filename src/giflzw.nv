// giflzw.nv — GIF's variable-width LZW, as a state machine the caller
// drives.
//
// IT IS NOT THE LZW EVERYONE KNOWS
//
// GIF's LZW differs from the textbook algorithm and from TIFF's in
// three ways, and each of the three has produced a decoder that works
// on most files and fails on some:
//
//   - The codes are packed LEAST SIGNIFICANT BIT FIRST within a byte,
//     which is the reverse of TIFF.
//   - The code width starts at `minimum_code_size + 1` and grows by
//     one each time the table fills, up to 12 bits — and the table is
//     considered full one code EARLY compared with the obvious
//     reading, which is the single most common bug.
//   - There is an explicit CLEAR code and an explicit END code, at
//     `2^minimum_code_size` and one above it, and a clear may arrive
//     at any point.
//
// So the state is a code width, a table, and a previous code, and it
// is exposed as a value rather than hidden in a loop, because the
// bytes arrive in sub-blocks of at most 255 and a caller streaming
// from a socket has to be able to stop between any two of them.
//
// THE DECODER DOES NOT ALLOCATE PER CALL
//
// `gifread` drives this; a caller can too.  `feed` takes the bytes it
// was given, `drain` takes the pixels out, and neither can be asked
// for more than the frame holds — `GifLzwOverrun` is what a stream
// that produces too many pixels gets, before the extra pixels are
// written anywhere.

// The largest code width GIF's LZW reaches.
pub const GIF_LZW_MAX_CODE_SIZE = 12

// The decoder's state between two feeds.
//
// ```novo
// use giflzw
//
// fn main() [io]
//     match giflzw.decoder(8, 64)
//         Ok(d)  => println("${giflzw.code_size_of(d)}")   // 9
//         Err(e) => println(e.message())
// ```
pub struct GifLzwDecoder
    // The `minimum code size` byte the image block carried, 2 to 12.
    minimum_code_size: Int
    // The current code width in bits, which starts one above the
    // minimum and grows to 12.
    code_size: Int
    // How many codes the table holds.
    table_size: Int
    // How many pixels have been produced.
    produced: Int
    // How many pixels the frame holds, which is where the decoder
    // stops.
    expected: Int
    // Whether the end code has been seen.
    finished: Bool

// The encoder's state between two frames' worth of pixels.
pub struct GifLzwEncoder
    // The `minimum code size` byte that will be written, 2 to 12.
    minimum_code_size: Int
    // The current code width in bits.
    code_size: Int
    // How many codes the table holds.
    table_size: Int
    // How many pixels have been consumed.
    consumed: Int

// A decoder for a frame, or `GifBadCodeSize` when the minimum code
// size is outside 2 to 12.
//
// The GIF specification allows a minimum code size of 2 at the
// smallest even for a two-colour image, because a one-bit code size
// leaves no room for the clear and end codes.
//
// ```novo
// use giflzw
//
// fn main() [io]
//     match giflzw.decoder(1, 64)
//         Ok(_)  => println("this cannot happen — 1 is below the floor")
//         Err(e) => println(e.message())
// ```
pub fn decoder(minimum_code_size: Int, pixel_count: Int) -> Result<GifLzwDecoder, GifFault> []
    todo("gif-nv.giflzw.decoder")

// The decoder's current code width in bits.
//
// It starts at `minimum_code_size + 1` and grows by one each time the
// table fills, to 12.
//
// ```novo
// use giflzw
//
// fn main() [io]
//     match giflzw.decoder(2, 16)
//         Ok(d)  => println("${giflzw.code_size_of(d)}")   // 3
//         Err(e) => println(e.message())
// ```
pub fn code_size_of(d: GifLzwDecoder) -> Int []
    todo("gif-nv.giflzw.code_size_of")

// The clear code for a minimum code size: `2^minimum_code_size`.
//
// ```novo
// use giflzw
//
// fn main() [io]
//     println("${giflzw.clear_code(8)}")        // 256
// ```
pub fn clear_code(minimum_code_size: Int) -> Int []
    todo("gif-nv.giflzw.clear_code")

// The end code for a minimum code size: one above the clear code.
//
// ```novo
// use giflzw
//
// fn main() [io]
//     println("${giflzw.end_code(8)}")          // 257
// ```
pub fn end_code(minimum_code_size: Int) -> Int []
    todo("gif-nv.giflzw.end_code")

// Bytes fed in, and the pixels they completed out.
//
// The whole of the feed-and-drain shape in one function: the caller
// owns the byte slice, this owns the table, and the answer is the
// decoder's new state and whatever became decodable.  A slice that
// completes no code answers an empty list, which is not an error.
//
// ```novo
// use std.bytes
// use giflzw
//
// fn main() [io]
//     match giflzw.decoder(2, 16)
//         Err(e) => println(e.message())
//         Ok(d)  =>
//             match giflzw.feed(d, bytes.from_byte_list([0x04]))
//                 Ok(step) => println("${bytes.len(step.1)}")
//                 Err(e)   => println(e.message())
// ```
pub fn feed(d: GifLzwDecoder, bytes: Bytes) -> Result<(GifLzwDecoder, Bytes), GifFault> []
    todo("gif-nv.giflzw.feed")

// Whether the end code has arrived and the frame is complete.
//
// ```novo
// use giflzw
//
// fn main() [io]
//     match giflzw.decoder(2, 16)
//         Ok(d)  => println("${giflzw.is_finished(d)}")   // false
//         Err(e) => println(e.message())
// ```
pub fn is_finished(d: GifLzwDecoder) -> Bool []
    todo("gif-nv.giflzw.is_finished")

// How many pixels the decoder still owes.
//
// Zero when the frame is full.  A stream whose end code arrives with
// this above zero is `GifLzwUnderrun`, and a caller checking a file
// rather than decoding it asks this instead of waiting for the
// refusal.
//
// ```novo
// use giflzw
//
// fn main() [io]
//     match giflzw.decoder(2, 16)
//         Ok(d)  => println("${giflzw.pixels_remaining(d)}")   // 16
//         Err(e) => println(e.message())
// ```
pub fn pixels_remaining(d: GifLzwDecoder) -> Int []
    todo("gif-nv.giflzw.pixels_remaining")

// A whole frame's compressed bytes decoded at once.
//
// The one-shot convenience, for a caller that already holds the entire
// image block.  `feed` is what a caller streaming from a socket uses.
//
// ```novo
// use std.bytes
// use giflzw
//
// fn main() [io]
//     match giflzw.decode_all(2, bytes.from_byte_list([0x8C, 0x2D, 0x99, 0x87, 0x2A]), 10)
//         Ok(px) => println("${bytes.len(px)}")   // 10
//         Err(e) => println(e.message())
// ```
pub fn decode_all(minimum_code_size: Int, bytes: Bytes,
                  pixel_count: Int) -> Result<Bytes, GifFault> []
    todo("gif-nv.giflzw.decode_all")

// An encoder for a palette of this size.
//
// The minimum code size is the number of bits the largest index needs,
// floored at 2.
//
// ```novo
// use giflzw
//
// fn main() [io]
//     match giflzw.encoder(4)
//         Ok(e)  => println("${e.minimum_code_size}")   // 2
//         Err(x) => println(x.message())
// ```
pub fn encoder(palette_size: Int) -> Result<GifLzwEncoder, GifFault> []
    todo("gif-nv.giflzw.encoder")

// Indices in, compressed bytes out, with the clear code already
// written.
//
// ```novo
// use std.bytes
// use giflzw
//
// fn main() [io]
//     match giflzw.encoder(4)
//         Err(x) => println(x.message())
//         Ok(e)  =>
//             match giflzw.encode_all(e, bytes.from_byte_list([0, 1, 1, 0]))
//                 Ok(out) => println("${bytes.len(out) > 0}")   // true
//                 Err(x)    => println(x.message())
// ```
pub fn encode_all(e: GifLzwEncoder, indices: Bytes) -> Result<Bytes, GifFault> []
    todo("gif-nv.giflzw.encode_all")

// The minimum code size a palette of this many colours needs: the bits
// the largest index takes, floored at 2.
//
// ```novo
// use giflzw
//
// fn main() [io]
//     println("${giflzw.minimum_code_size_for(2)}")     // 2
//     println("${giflzw.minimum_code_size_for(256)}")   // 8
// ```
pub fn minimum_code_size_for(palette_size: Int) -> Int []
    todo("gif-nv.giflzw.minimum_code_size_for")

// Bytes cut into the sub-blocks the format stores them in: a length
// byte of 1 to 255, then that many bytes, repeating, then a zero.
//
// Public because it is the framing, not the compression, and a caller
// reading a file it is validating wants to walk the sub-blocks without
// decompressing anything.
//
// ```novo
// use std.bytes
// use giflzw
//
// fn main() [io]
//     println("${bytes.len(giflzw.to_sub_blocks(bytes.from_byte_list([1, 2, 3])))}")   // 5
// ```
pub fn to_sub_blocks(bytes: Bytes) -> Bytes []
    todo("gif-nv.giflzw.to_sub_blocks")
